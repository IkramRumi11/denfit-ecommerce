# Example production env file - DO NOT COMMIT SECRETS
NODE_ENV=production
PORT=3002
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.example.mongodb.net/denfit
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=7d

# SMTP (production mail provider)
SMTP_HOST=smtp.sendprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis URL for job queue
REDIS_URL=redis://:password@redis-host:6379

# Production frontends allowed (comma separated)
ALLOWED_ORIGINS=https://yourdomain.com

# Force HTTPS (useful if terminating TLS at a load balancer)
FORCE_HTTPS=true

# Additional safety: disallow any developer backdoors by default in production.
ALLOW_DEV_BACKDOORS=false
