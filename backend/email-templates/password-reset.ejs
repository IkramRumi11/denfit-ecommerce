<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Password Reset — DENFiT</title>
  <style>
    body { margin:0; padding:0; background:#f4f6f8; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; color:#263238; }
    .wrap { max-width:680px; margin:28px auto; background:#fff; border-radius:8px; overflow:hidden; box-shadow:0 8px 30px rgba(3,10,18,0.06); }
    /* Compact header and circular logo (updated: smaller, warm gradient, brand text) */
    .header { padding: 12px 8px 10px; background-color:#ffd6a5; background-image:linear-gradient(135deg,#ffd6a5 0%, #ff9a3c 100%); color: #3b2f2f; text-align:center; display:flex; align-items:center; justify-content:center; flex-direction:column; }
    .header-inner { display:inline-block; padding:8px; border-radius:999px; background-color:#fff8f2; background-image:linear-gradient(180deg,#fff8f2,#fff2e6); }
    .logo { display:block; width:88px; height:88px; max-width:88px; max-height:88px; border-radius:50%; object-fit:cover; margin:0 auto; }
    .brand { display:block; font-size:18px; font-weight:800; font-family:'Trebuchet MS', 'Segoe UI', Roboto, Arial, sans-serif; color:#5a2d0c; margin-top:8px; line-height:1; transform:rotate(-3deg); -webkit-transform:rotate(-3deg); }
    .content{ padding:28px; }
    h2{ margin:0 0 10px; font-size:18px; color:#0b1220 }
    p{ color:#455a64; font-size:15px; line-height:1.6 }
    .btn{ display:inline-block; background:#dc2626; color:#fff; padding:12px 20px; border-radius:8px; text-decoration:none; margin:18px 0; font-weight:700 }
    .notice{ background:#fff5f5; border:1px solid #f8d7da; color:#b91c1c; padding:12px; border-radius:8px; margin:16px 0; font-size:13px }
    .footer{ background:#fbfcfd; padding:18px; text-align:center; color:#9aa7af; font-size:13px }
    @media (max-width:520px){ .content{padding:18px} .header{padding:14px} .brand{display:block; margin-left:0; margin-top:8px} .logo{width:72px; height:72px; max-width:72px; max-height:72px;} }
  </style>
</head>
<body>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center">
        <div class="wrap" role="article" aria-label="DENFiT password reset">
          <div class="header">
            <div class="header-inner" style="display:inline-block; padding:8px; border-radius:999px; background: linear-gradient(180deg,#fff8f2,#fff2e6);">
              <img src="<%= brand.logo %>" alt="<%= brand.name %> logo" class="logo" style="display:block; border:0; width:88px; height:88px; max-width:88px; max-height:88px; border-radius:50%; object-fit:cover; margin:0 auto;" />
            </div>
            <div class="brand" style="font-size:18px; font-weight:800; font-family:'Trebuchet MS', 'Segoe UI', Roboto, Arial, sans-serif; color:#5a2d0c; margin-top:8px; line-height:1; transform:rotate(-3deg); -webkit-transform:rotate(-3deg);"><%= brand.name %></div>
          </div>

          <div class="content">
            <h2>Password reset request</h2>
            <p>Hi <strong><%= name %></strong>,</p>
            <p>We received a request to reset your password. Click the button below to set a new password for your account.</p>

            <p style="text-align:center;">
              <a href="<%= resetUrl %>" class="btn" target="_blank" rel="noopener noreferrer">Reset Password</a>
            </p>

            <div class="notice">
              <strong>Security note:</strong> this link will expire in 10 minutes. If you did not request this change, please ignore this message or contact us at <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>.
            </div>

            <p>If the button doesn't work, copy and paste this URL into your browser:</p>
            <p style="word-break:break-all;"><a href="<%= resetUrl %>" class="textlink"><%= resetUrl %></a></p>
          </div>

          <div class="footer">
            &copy; <%= year %> <strong><%= brand.name %></strong>. All rights reserved.
          </div>
        </div>
      </td>
    </tr>
  </table>
</body>
</html>
