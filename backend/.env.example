# Backend environment template.
# Copy this file to backend/.env and replace placeholder values before running locally or in Docker.
NODE_ENV=development
PORT=3002
MONGODB_URI=mongodb://localhost:27017/denfit-ecommerce

JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_BYTE_HEX_VALUE
JWT_EXPIRES_IN=90d
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=90
JWT_ACCESS_EXPIRES_IN=15m

FRONTEND_URL=http://localhost:3000
ALLOW_DEV_BACKDOORS=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me@example.com
SMTP_PASS=CHANGE_ME_APP_PASSWORD
SMTP_FROM="DENFiT Support <noreply@denfit.com>"

CLOUDINARY_CLOUD_NAME=CHANGE_ME_CLOUD_NAME
CLOUDINARY_API_KEY=CHANGE_ME_API_KEY
CLOUDINARY_API_SECRET=CHANGE_ME_API_SECRET

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=redis://localhost:6379

# During local dev only - never set to true in production!
# ALLOW_DEV_BACKDOORS=false

# Use a dedicated test or integration DB for integration tests
# MONGODB_URI=mongodb://localhost:27017/denfit-ecommerce-test
