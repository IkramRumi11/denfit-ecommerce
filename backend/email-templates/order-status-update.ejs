<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Order Status Update - #<%= order.orderNumber %></title>
  <style>
    body { margin:0; padding:0; background:#f4f6f8; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; color:#263238; }
    .wrap { max-width: 680px; margin: 20px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 20px rgba(3,10,18,0.06); }
    /* Compact header (sleek slim height, brand badge) */
    .header { padding: 6px 12px; background-color:#ffd6a5; background-image:linear-gradient(135deg,#ffd6a5 0%, #ff9a3c 100%); color: #3b2f2f; text-align:center; }
    .header-table { margin: 0 auto; border-collapse: collapse; }
    .header-inner { display:inline-block; padding:2px; border-radius:50%; background-color:#fff8f2; background-image:linear-gradient(180deg,#fff8f2,#fff2e6); vertical-align:middle; }
    .logo { display:block; width:26px; height:26px; max-width:26px; max-height:26px; border-radius:50%; object-fit:cover; margin:0 auto; }
    .brand { display:inline-block; font-size:16px; font-weight:800; font-family:'Trebuchet MS', 'Segoe UI', Roboto, Arial, sans-serif; color:#5a2d0c; line-height:1; transform:rotate(-2deg); -webkit-transform:rotate(-2deg); vertical-align:middle; }
    .content { padding: 28px 32px; }
    h1 { font-size:20px; margin:0 0 12px; color:#0b1220; }
    p { color:#455a64; font-size:15px; line-height:1.6; margin:0 0 14px; }
    .cta { display:block; width: fit-content; margin: 18px auto; background:#000; color:#fff; padding:12px 22px; border-radius:8px; text-decoration:none; font-weight:600; }
    .muted { font-size:13px; color:#90a4ae; }
    .table { width:100%; border-collapse: collapse; margin: 16px 0; }
    .table td { padding:8px; border:1px solid #eee; }
    .items { width:100%; border-collapse: collapse; margin: 16px 0; }
    .items th, .items td { padding:10px 8px; border-bottom:1px solid #eee; text-align:left; }
    .footer { background:#fbfcfd; padding:16px 20px; text-align:center; color:#9aa7af; font-size:13px; }
    @media (max-width:520px){ .content{padding:20px} .header{padding:6px 10px} .logo{width:22px; height:22px; max-width:22px; max-height:22px;} .brand{font-size:15px;} }
  </style>
</head>
<body>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center">
        <div class="wrap" role="article" aria-label="Order update">
          <div class="header">
            <table cellpadding="0" cellspacing="0" border="0" class="header-table" style="margin:0 auto; display:inline-table; border-collapse:collapse;">
              <tr>
                <td style="vertical-align:middle; padding-right:8px;">
                  <div class="header-inner">
                    <img src="<%= brand.logo %>" alt="<%= brand.name %> logo" class="logo" style="display:block; border:0; width:26px; height:26px; max-width:26px; max-height:26px; border-radius:50%; object-fit:cover;" />
                  </div>
                </td>
                <td style="vertical-align:middle;">
                  <span class="brand"><%= brand.name %></span>
                </td>
              </tr>
            </table>
          </div>

          <div class="content">
            <h1>Order Status Update</h1>
            <p>Hi <%= name %>,</p>
            <p>The status of your order <strong>#<%= order.orderNumber %></strong> has been updated to <strong><%= newStatus.charAt(0).toUpperCase() + newStatus.slice(1) %></strong>.</p>

            <% // Prefer explicit adminNote; fall back to most recent statusHistory note if available %>
            <% let adminNote = (order && order.adminNote) || (order && order.statusHistory && order.statusHistory.length ? order.statusHistory[order.statusHistory.length - 1].note : undefined); %>
            <% if (adminNote) { %>
              <p><strong>Note from admin:</strong> <%= adminNote %></p>
            <% } %>

            <table class="table">
              <tr>
                <td>Previous status</td>
                <td><strong><%= oldStatus || 'n/a' %></strong></td>
              </tr>
              <tr>
                <td>Current status</td>
                <td><strong><%= newStatus %></strong></td>
              </tr>
              <tr>
                <td>Order total</td>
                <td>Rs <%= ((order.subtotal || 0) + (order.shippingCost || 0)).toFixed(2) %></td>
              </tr>
            </table>

            <% if (order.items && order.items.length) { %>
              <h3 style="margin-top:12px">Items</h3>
              <table class="items" role="presentation">
                <thead>
                  <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th>Price</th>
                  </tr>
                </thead>
                <tbody>
                  <% (order.items || []).forEach(function(it){ %>
                    <tr>
                      <td>
                        <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse;">
                          <tr>
                            <td style="padding: 0; border: 0; vertical-align: middle;">
                              <% 
                                let itemImg = it.image;
                                if (!itemImg && it.product && it.product.images && it.product.images.length > 0) {
                                  const pri = it.product.images.find(img => img.isPrimary);
                                  itemImg = pri ? pri.url : it.product.images[0].url;
                                }
                                if (!itemImg) {
                                  itemImg = 'https://i.ibb.co/GQG243Rb/DENFiT.jpg'; // fallback
                                }
                              %>
                              <img src="<%= itemImg %>" alt="Product thumbnail" width="50" height="50" style="display: block; width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #e5e7eb;" />
                            </td>
                            <td style="padding: 0 0 0 12px; border: 0; vertical-align: middle;">
                              <strong style="display: block; font-size: 13px; margin-bottom: 2px; color: #263238;">
                                <%= it.name || it.title || it.productName || 'Item' %>
                              </strong>
                              <% 
                                const colorObj = it.color && typeof it.color === 'object' ? it.color : null;
                                const colorName = it.colorName || (colorObj ? (colorObj.name || undefined) : undefined);
                                const variantHex = it.variantHex || (colorObj ? (colorObj.hex || undefined) : undefined);
                                const colorValue = typeof it.color === 'string' ? it.color : (variantHex || undefined);
                                const label = colorName || colorValue || '';
                                const displayLabel = getColorName(label);
                                const resolvedHex = resolveColorHex(colorValue || label);
                              %>
                              <% if (it.size || displayLabel) { %>
                                <div style="font-size: 11px; color: #90a4ae; margin-top: 2px; line-height: 14px;">
                                  <% if (it.size) { %>Size: <%= it.size %><% } %>
                                  <% if (it.size && displayLabel) { %> • <% } %>
                                  <% if (displayLabel) { %>
                                    <span style="display: inline-block; vertical-align: middle;">
                                      Color:
                                      <% if (resolvedHex) { %>
                                        <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background-color: <%= resolvedHex %>; border: 1px solid #ddd; vertical-align: middle; margin: 0 2px;"></span>
                                      <% } %>
                                      <span style="text-transform: capitalize; vertical-align: middle;"><%= displayLabel %></span>
                                    </span>
                                  <% } %>
                                </div>
                              <% } %>
                            </td>
                          </tr>
                        </table>
                      </td>
                      <td><%= it.quantity %></td>
                      <td>Rs <%= (it.price || 0).toFixed(2) %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            <% } %>

            <% if (order.trackingNumber) { %>
              <p>Tracking: <strong>
                <% if (order.trackingUrl) { %>
                  <a href="<%= order.trackingUrl %>" target="_blank" rel="noopener noreferrer" style="color:inherit; text-decoration:underline;"><%= order.trackingNumber %></a>
                <% } else { %>
                  <%= order.trackingNumber %>
                <% } %>
              </strong> (<%= order.carrier || 'carrier' %>)</p>
            <% } %>

            <p style="text-align:center;">
              <a href="<%= ctaUrl %>" class="cta" target="_blank" rel="noopener noreferrer">View order</a>
            </p>

            <p>If you didn't expect this change, contact <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>.</p>
            <p class="muted">Thank you,<br/>The <%= brand.name %> Team</p>
          </div>

          <div class="footer">
            &copy; <%= year %> <strong><%= brand.name %></strong>
          </div>
        </div>
      </td>
    </tr>
  </table>
</body>
</html>
