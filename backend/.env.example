# Backend environment variables example
NODE_ENV=development
PORT=3002
MONGODB_URI=mongodb://localhost:27017/denfit-ecommerce

JWT_SECRET=your_long_random_jwt_secret
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES_IN=90

FRONTEND_URL=http://localhost:3000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM="DENFiT Support <noreply@example.com>"

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# During local dev only - never set to true in production!
ALLOW_DEV_BACKDOORS=false

# Use a dedicated test or integration DB for integration tests
# MONGODB_URI=mongodb://localhost:27017/denfit-ecommerce-test
