# DENFiT E-commerce - Example environment variables

# App
NODE_ENV=development
PORT=3002
# Frontend dev origin(s), comma-separated
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
FORCE_HTTPS=false

# Database
MONGODB_URI=mongodb://localhost:27017/denfit_dev

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# SMTP (for sending emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=supersecret

# Cloudinary (for media)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Redis (for job queue)
REDIS_URL=redis://localhost:6379

# Dev flags
# When true, skips CSRF validation (ONLY for local debugging). Do NOT enable in prod.
SKIP_CSRF=false

# Extra safety: opt-in to any developer backdoors (must be explicitly set in dev)
# Set to 'true' if you need to enable dev-only backdoors like SKIP_CSRF during debugging.
ALLOW_DEV_BACKDOORS=false

# SSL (optional - for local HTTPS mkcert)
SSL_KEY_PATH=./certs/localhost.key
SSL_CERT_PATH=./certs/localhost.crt

# Optional
# ALLOW_DEV_EMAILS=true
# ENABLE_EMAIL_QUEUE=true
